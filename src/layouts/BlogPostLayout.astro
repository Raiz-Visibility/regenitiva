---
import BaseLayout from './BaseLayout.astro';
import ApplicationForm from '../components/ApplicationForm.astro';
import '../styles/prose.css';
import '../styles/article-layout.css';

interface Props {
  title: string;
  description?: string;
  category: string;
  date: string;
  author: string;
  authorSlug?: string;
  authorTitle: string;
  authorBio: string;
  readTime: number;
  relatedPosts: Array<{ slug: string; title: string; category: string; date: string }>;
}

const {
  title,
  description,
  category,
  date,
  author,
  authorSlug,
  authorTitle,
  authorBio,
  readTime,
  relatedPosts,
} = Astro.props;

import { slugifyCategory } from '../lib/blog';
const categorySlug = slugifyCategory(category);
---

<BaseLayout title={title} description={description}>

  <!-- Header -->
  <header class="bp-header">
    <div class="bp-header-inner">
      <a href="/blog/" class="bp-back">&larr; Back to blog</a>
      <a href={`/blog/category/${categorySlug}/`} class="bp-category">{category}</a>
      <h1 class="bp-title">{title}</h1>
      <div class="bp-meta">
        {authorSlug
          ? <a href={`/about/${authorSlug}/`} class="bp-author-link">{author}</a>
          : <span>{author}</span>
        }
        <span class="bp-meta-sep">&middot;</span>
        <span>{date}</span>
        <span class="bp-meta-sep">&middot;</span>
        <span>{readTime} min read</span>
      </div>
    </div>
  </header>

  <!-- Featured image placeholder -->
  <div class="bp-cover">
    <div class="bp-cover-inner">
      <div class="bp-cover-placeholder"></div>
    </div>
  </div>

  <!-- Mobile TOC -->
  <details class="al-mobile-toc">
    <summary class="al-mobile-toc-toggle">
      <span>On this page</span>
      <span class="al-mobile-toc-chevron" aria-hidden="true">&#9662;</span>
    </summary>
    <nav class="al-mobile-toc-links" data-toc-target></nav>
  </details>

  <!-- Layout grid -->
  <div class="al-grid">
    <article class="prose">
      <slot />
    </article>
    <aside class="al-sidebar">
      <div class="al-toc-card">
        <div class="al-sidebar-label">On This Page</div>
        <nav class="al-toc-links" data-toc-target></nav>
      </div>
      <ApplicationForm />
      {relatedPosts.length > 0 && (
        <div class="al-sidebar-card">
          <div class="al-sidebar-label">Related Posts</div>
          <ul class="bp-related-sidebar-list">
            {relatedPosts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}/`} class="bp-related-sidebar-link">
                  <span class="bp-related-sidebar-title">{post.title}</span>
                  <span class="bp-related-sidebar-meta">{post.category} &middot; {post.date}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>

  <!-- Author bio -->
  <section class="bp-author">
    <div class="bp-author-inner">
      <div class="bp-author-avatar"></div>
      <div class="bp-author-text">
        <div class="bp-author-name">{author}</div>
        <div class="bp-author-role">{authorTitle}</div>
        <p class="bp-author-bio">{authorBio}</p>
      </div>
    </div>
  </section>

  <!-- Related posts grid -->
  {relatedPosts.length > 0 && (
    <section class="bp-related">
      <div class="bp-related-inner">
        <h2 class="bp-related-heading">More from {category}</h2>
        <div class="bp-related-grid">
          {relatedPosts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="bp-related-card">
              <div class="bp-related-thumb"></div>
              <div class="bp-related-category">{post.category}</div>
              <h3 class="bp-related-title">{post.title}</h3>
              <div class="bp-related-date">{post.date}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ----------------------------------------------------------------
     Header
     ---------------------------------------------------------------- */
  .bp-header {
    border-bottom: 1px solid var(--rg-border);
  }

  .bp-header-inner {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--rg-space-7) var(--rg-space-5) var(--rg-space-6);
    text-align: center;
  }

  .bp-back {
    display: inline-block;
    font-size: 14px;
    font-weight: var(--rg-weight-medium);
    color: var(--rg-stone-600);
    text-decoration: none;
    margin-bottom: var(--rg-space-5);
  }

  .bp-back:hover {
    color: var(--rg-text-primary);
    text-decoration: none;
  }

  .bp-category {
    display: block;
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-eyebrow);
    font-weight: var(--rg-weight-bold);
    letter-spacing: var(--rg-ls-eyebrow);
    text-transform: uppercase;
    color: var(--rg-amber-800);
    text-decoration: none;
    margin-bottom: var(--rg-space-4);
  }

  .bp-category:hover {
    color: var(--rg-amber-900);
    text-decoration: none;
  }

  .bp-title {
    font-size: var(--rg-size-h1);
    font-weight: var(--rg-weight-regular);
    line-height: var(--rg-lh-h1);
    letter-spacing: var(--rg-ls-h1);
    margin-bottom: var(--rg-space-5);
  }

  .bp-meta {
    font-size: var(--rg-size-small);
    color: var(--rg-stone-600);
  }

  .bp-meta-sep {
    margin: 0 var(--rg-space-2);
  }

  .bp-author-link {
    color: var(--rg-text-accent);
    text-decoration: none;
    font-weight: var(--rg-weight-medium);
  }

  .bp-author-link:hover {
    text-decoration: underline;
  }

  /* ----------------------------------------------------------------
     Cover image
     ---------------------------------------------------------------- */
  .bp-cover {
    border-bottom: 1px solid var(--rg-border);
  }

  .bp-cover-inner {
    max-width: var(--rg-container-article);
    margin: 0 auto;
    padding: 0 var(--rg-space-5);
  }

  .bp-cover-placeholder {
    width: 100%;
    aspect-ratio: 21 / 9;
    background: var(--rg-stone-300);
    border-radius: var(--rg-radius-lg);
    margin: var(--rg-space-6) 0;
  }

  @media (min-width: 768px) {
    .bp-cover-inner {
      padding: 0 var(--rg-space-7);
    }
  }

  /* ----------------------------------------------------------------
     Sidebar related posts list
     ---------------------------------------------------------------- */
  .bp-related-sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--rg-space-3);
  }

  .bp-related-sidebar-link {
    display: block;
    text-decoration: none;
    padding: var(--rg-space-3) 0;
    border-bottom: 1px solid var(--rg-border);
  }

  .bp-related-sidebar-link:hover {
    text-decoration: none;
  }

  .bp-related-sidebar-list li:last-child .bp-related-sidebar-link {
    border-bottom: none;
    padding-bottom: 0;
  }

  .bp-related-sidebar-title {
    display: block;
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-small);
    font-weight: var(--rg-weight-semibold);
    color: var(--rg-text-primary);
    line-height: 1.3;
    margin-bottom: var(--rg-space-1);
  }

  .bp-related-sidebar-meta {
    display: block;
    font-size: var(--rg-size-caption);
    color: var(--rg-text-muted);
  }

  /* ----------------------------------------------------------------
     Author bio
     ---------------------------------------------------------------- */
  .bp-author {
    border-top: 1px solid var(--rg-border);
  }

  .bp-author-inner {
    max-width: var(--rg-container);
    margin: 0 auto;
    padding: var(--rg-space-7) var(--rg-space-5);
    display: flex;
    gap: var(--rg-space-5);
    align-items: flex-start;
  }

  .bp-author-avatar {
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--rg-stone-300);
  }

  .bp-author-name {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-h5);
    font-weight: var(--rg-weight-semibold);
    color: var(--rg-text-primary);
    margin-bottom: var(--rg-space-1);
  }

  .bp-author-role {
    font-size: var(--rg-size-small);
    color: var(--rg-text-accent);
    margin-bottom: var(--rg-space-3);
  }

  .bp-author-bio {
    font-size: var(--rg-size-small);
    line-height: var(--rg-lh-body);
    color: var(--rg-text-secondary);
  }

  @media (min-width: 768px) {
    .bp-author-inner {
      padding: var(--rg-space-7) var(--rg-space-7);
    }

    .bp-author-avatar {
      flex: 0 0 80px;
      width: 80px;
      height: 80px;
    }
  }

  /* ----------------------------------------------------------------
     Related posts grid (bottom)
     ---------------------------------------------------------------- */
  .bp-related {
    border-top: 1px solid var(--rg-border);
  }

  .bp-related-inner {
    max-width: var(--rg-container);
    margin: 0 auto;
    padding: var(--rg-space-7) var(--rg-space-5) var(--rg-space-8);
  }

  .bp-related-heading {
    font-size: var(--rg-size-h2);
    font-weight: var(--rg-weight-regular);
    line-height: var(--rg-lh-h2);
    letter-spacing: var(--rg-ls-h2);
    margin-bottom: var(--rg-space-6);
  }

  .bp-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--rg-space-5);
  }

  .bp-related-card {
    display: block;
    text-decoration: none;
    border: 1px solid var(--rg-border);
    border-radius: var(--rg-radius-lg);
    background: var(--rg-bg-surface);
    overflow: hidden;
    transition: box-shadow var(--rg-duration-slow) var(--rg-ease);
  }

  .bp-related-card:hover {
    text-decoration: none;
    box-shadow: var(--rg-shadow-2);
  }

  .bp-related-thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--rg-stone-300);
  }

  .bp-related-category {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-eyebrow);
    font-weight: var(--rg-weight-bold);
    letter-spacing: var(--rg-ls-eyebrow);
    text-transform: uppercase;
    color: var(--rg-text-accent);
    padding: var(--rg-space-4) var(--rg-space-5) 0;
  }

  .bp-related-title {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-h5);
    font-weight: var(--rg-weight-semibold);
    line-height: var(--rg-lh-h5);
    color: var(--rg-text-primary);
    padding: var(--rg-space-2) var(--rg-space-5) 0;
  }

  .bp-related-date {
    font-size: var(--rg-size-caption);
    color: var(--rg-text-muted);
    padding: var(--rg-space-2) var(--rg-space-5) var(--rg-space-5);
  }

  @media (min-width: 768px) {
    .bp-related-inner {
      padding: var(--rg-space-7) var(--rg-space-7) var(--rg-space-8);
    }

    .bp-related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script src="../scripts/toc.ts"></script>
