---
import BaseLayout from './BaseLayout.astro';
import ApplicationForm from '../components/ApplicationForm.astro';
import '../styles/prose.css';
import '../styles/article-layout.css';

interface Props {
  title: string;
  description?: string;
  heroEyebrow?: string;
  heroTitle: string;
  heroPromise?: string;
  heroSupport?: string;
  heroImage?: string;
}

const {
  title,
  description,
  heroEyebrow = 'Services',
  heroTitle,
  heroPromise,
  heroSupport,
  heroImage,
} = Astro.props;
---

<BaseLayout title={title} description={description}>

  <!-- Hero -->
  <section class="svc-hero">
    <div class="svc-hero-inner">
      <div class="svc-hero-text">
        <div class="svc-hero-eyebrow">{heroEyebrow}</div>
        <h1 class="svc-hero-h1">{heroTitle}</h1>
        {heroPromise && <p class="svc-hero-promise">{heroPromise}</p>}
        {heroSupport && <p class="svc-hero-support">{heroSupport}</p>}
      </div>
      <div class="svc-hero-photo">
        {heroImage
          ? <img src={heroImage} alt="" />
          : <div class="svc-hero-placeholder"></div>
        }
      </div>
    </div>
  </section>

  <!-- Mobile TOC -->
  <details class="al-mobile-toc">
    <summary class="al-mobile-toc-toggle">
      <span>On this page</span>
      <span class="al-mobile-toc-chevron" aria-hidden="true">&#9662;</span>
    </summary>
    <nav class="al-mobile-toc-links" data-toc-target></nav>
  </details>

  <!-- Layout grid -->
  <div class="al-grid">
    <article class="prose">
      <slot />
    </article>
    <aside class="al-sidebar">
      <div class="al-toc-card">
        <div class="al-sidebar-label">On This Page</div>
        <nav class="al-toc-links" data-toc-target></nav>
      </div>
      <ApplicationForm />
    </aside>
  </div>

</BaseLayout>

<style>
  /* ----------------------------------------------------------------
     Hero
     ---------------------------------------------------------------- */
  .svc-hero {
    border-bottom: 1px solid var(--rg-border);
  }

  .svc-hero-inner {
    display: flex;
    flex-direction: column;
  }

  .svc-hero-photo {
    order: -1;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .svc-hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .svc-hero-placeholder {
    width: 100%;
    height: 100%;
    background: var(--rg-stone-300);
  }

  .svc-hero-text {
    padding: var(--rg-space-5) var(--rg-space-5) 40px;
  }

  .svc-hero-eyebrow {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-eyebrow);
    font-weight: var(--rg-weight-bold);
    letter-spacing: var(--rg-ls-eyebrow);
    text-transform: uppercase;
    color: var(--rg-text-accent);
    margin-bottom: var(--rg-space-4);
  }

  .svc-hero-h1 {
    font-size: var(--rg-size-h1);
    line-height: var(--rg-lh-h1);
    letter-spacing: var(--rg-ls-h1);
    margin-bottom: 20px;
    max-width: 820px;
  }

  .svc-hero-promise {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-h4);
    font-weight: var(--rg-weight-medium);
    line-height: var(--rg-lh-h4);
    color: var(--rg-text-accent);
    max-width: 700px;
    margin-bottom: 20px;
  }

  .svc-hero-support {
    font-size: var(--rg-size-body);
    line-height: var(--rg-lh-body);
    color: var(--rg-text-secondary);
    max-width: 700px;
  }

  @media (min-width: 768px) {
    .svc-hero {
      overflow: hidden;
    }

    .svc-hero-inner {
      position: relative;
      max-width: var(--rg-container-article);
      margin: 0 auto;
      padding: 72px var(--rg-space-7) 56px;
    }

    .svc-hero-text {
      padding: 0;
      max-width: calc(100% - 400px);
    }

    .svc-hero-photo {
      order: 0;
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: auto;
      height: 100%;
      aspect-ratio: 1;
    }
  }

</style>

<script src="../scripts/toc.ts"></script>
