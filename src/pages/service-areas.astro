---
import BaseLayout from '../layouts/BaseLayout.astro';

const states = [
  {
    name: 'Tennessee',
    status: 'Where we\'re based',
    body: 'Regenitiva is headquartered in Clarksville, Tennessee — our home base and where operations are run from.',
  },
  {
    name: 'California',
    status: 'Active',
    body: 'California is where we currently work most closely with practices delivering regenerative medicine.',
  },
  {
    name: 'Florida',
    status: 'Expanding',
    body: 'Florida is a planned expansion market. If you\'re a Florida practice considering a regenerative program, we\'d like to talk early.',
  },
];
---

<BaseLayout title="Service Areas — Regenitiva" description="Regenitiva is based in Clarksville, Tennessee, and works with regenerative medicine practices nationwide, building each program around the requirements of the state you practice in."
  noindex={true}>

  <!-- Header -->
  <section class="sa-header">
    <div class="sa-header-inner">
      <div class="sa-eyebrow">Service Areas</div>
      <h1>Built around the state you practice in.</h1>
      <p class="sa-intro">Regenitiva is headquartered in Clarksville, Tennessee, and works with practices across the country. Because compliance, licensing, and billing vary by state, we build every program around where you actually practice — and we travel to deliver training on-site.</p>
    </div>
  </section>

  <!-- States -->
  <section class="sa-states">
    <div class="sa-states-inner">
      <div class="sa-states-grid">
        {states.map((s) => (
          <div class="sa-state-card">
            <div class="sa-state-status">{s.status}</div>
            <h2 class="sa-state-name">{s.name}</h2>
            <p class="sa-state-body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nationwide -->
  <section class="sa-nationwide">
    <div class="sa-nationwide-inner">
      <h2 class="sa-nationwide-head">Practicing somewhere else?</h2>
      <p class="sa-nationwide-body">We work with practices nationwide, not just in the states above. In-person training is delivered on-site wherever you are, and the rest of the program — protocol, compliance documentation, and operational support — is built around your state's specific requirements.</p>
      <p class="sa-nationwide-body">If you're weighing a regenerative medicine program and want to know whether it's a fit for your practice and your market, the best next step is a short conversation.</p>
      <a href="/contact" class="sa-btn">Schedule A Call</a>
    </div>
  </section>

  <!-- Why state matters -->
  <section class="sa-why">
    <div class="sa-why-inner">
      <div class="sa-eyebrow">Why your state matters</div>
      <h2 class="sa-why-head">One program, adapted to your requirements.</h2>
      <div class="sa-why-grid">
        <div class="sa-why-item">
          <div class="sa-why-label">Compliance</div>
          <p class="sa-why-body">Policies and procedures are written to align with AAAHC standards and the regulatory environment where you practice.</p>
        </div>
        <div class="sa-why-item">
          <div class="sa-why-label">Licensing</div>
          <p class="sa-why-body">Provider onboarding and privileging are handled with your state's licensing requirements in mind.</p>
        </div>
        <div class="sa-why-item">
          <div class="sa-why-label">Billing</div>
          <p class="sa-why-body">Billing and coding guidance — including lien handling for personal-injury patients — is scoped to your state and payer mix.</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .sa-header-inner {
    max-width: var(--rg-container);
    margin: 0 auto;
    padding: 40px var(--rg-space-5) 0;
  }

  .sa-eyebrow {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-eyebrow);
    font-weight: var(--rg-weight-bold);
    letter-spacing: var(--rg-ls-eyebrow);
    text-transform: uppercase;
    color: var(--rg-text-accent);
    margin-bottom: var(--rg-space-4);
  }

  .sa-intro {
    font-size: var(--rg-size-body);
    line-height: var(--rg-lh-body);
    color: var(--rg-text-secondary);
    max-width: var(--rg-measure-lead);
    margin-top: var(--rg-space-4);
  }

  @media (min-width: 768px) {
    .sa-header-inner { padding: 72px var(--rg-space-7) 0; }
  }

  /* States */
  .sa-states-inner {
    max-width: var(--rg-container);
    margin: 0 auto;
    padding: var(--rg-space-7) var(--rg-space-5);
  }

  .sa-states-grid {
    display: flex;
    flex-direction: column;
    gap: var(--rg-space-5);
  }

  .sa-state-card {
    padding: 28px var(--rg-space-5);
    border: 1px solid var(--rg-border);
    border-radius: var(--rg-radius-lg);
    background: var(--rg-bg-surface);
  }

  .sa-state-status {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-eyebrow);
    font-weight: var(--rg-weight-bold);
    letter-spacing: var(--rg-ls-eyebrow);
    text-transform: uppercase;
    color: var(--rg-text-accent);
    margin-bottom: var(--rg-space-3);
  }

  .sa-state-name {
    font-size: var(--rg-size-h3);
    margin-bottom: var(--rg-space-3);
  }

  .sa-state-body {
    font-size: var(--rg-size-body);
    line-height: var(--rg-lh-body);
    color: var(--rg-text-secondary);
  }

  @media (min-width: 768px) {
    .sa-states-inner { padding: var(--rg-space-8) var(--rg-space-7); }
    .sa-states-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--rg-space-6); }
    .sa-state-card { padding: 32px; }
  }

  /* Nationwide */
  .sa-nationwide {
    background: var(--rg-bg-inverse);
    color: var(--rg-text-on-inverse);
  }

  .sa-nationwide-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--rg-space-8) var(--rg-space-5);
    text-align: center;
  }

  .sa-nationwide-head {
    color: var(--rg-text-on-inverse);
    margin-bottom: var(--rg-space-5);
  }

  .sa-nationwide-body {
    font-size: var(--rg-size-body);
    line-height: var(--rg-lh-body);
    color: var(--rg-stone-300);
    margin: 0 auto var(--rg-space-5);
  }

  .sa-btn {
    display: inline-block;
    font-family: var(--rg-font-body);
    font-size: var(--rg-size-button);
    font-weight: var(--rg-weight-medium);
    letter-spacing: var(--rg-ls-button);
    background: var(--rg-amber-500);
    color: var(--rg-ink-900);
    border: 1px solid var(--rg-amber-500);
    border-radius: var(--rg-radius-md);
    padding: var(--rg-space-4) 30px;
    text-decoration: none;
    margin-top: var(--rg-space-3);
    transition: background var(--rg-duration-base) ease-out, border-color var(--rg-duration-base) ease-out;
  }

  .sa-btn:hover {
    background: var(--rg-amber-600);
    border-color: var(--rg-amber-600);
    color: var(--rg-ink-900);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .sa-nationwide-inner { padding: 100px var(--rg-space-7); }
  }

  /* Why state matters */
  .sa-why-inner {
    max-width: var(--rg-container);
    margin: 0 auto;
    padding: var(--rg-space-8) var(--rg-space-5);
  }

  .sa-why-head {
    margin: 0 0 var(--rg-space-7);
  }

  .sa-why-grid {
    display: flex;
    flex-direction: column;
    gap: var(--rg-space-6);
  }

  .sa-why-item {
    border-left: 2px solid var(--rg-border);
    padding-left: 18px;
  }

  .sa-why-label {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-eyebrow);
    font-weight: var(--rg-weight-bold);
    letter-spacing: var(--rg-ls-eyebrow);
    text-transform: uppercase;
    color: var(--rg-text-accent);
    margin-bottom: 10px;
  }

  .sa-why-body {
    font-size: var(--rg-size-button);
    line-height: 1.6;
    color: var(--rg-text-secondary);
  }

  @media (min-width: 768px) {
    .sa-why-inner { padding: 88px var(--rg-space-7); }
    .sa-why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--rg-space-6); }
  }
</style>
