---
import '../styles/global.css';

const ambers = [
  { token: '--rg-amber-300', hex: '#FFCD4D', name: 'amber-300' },
  { token: '--rg-amber-400', hex: '#FAAF33', name: 'amber-400' },
  { token: '--rg-amber-500', hex: '#F59621', name: 'amber-500' },
  { token: '--rg-amber-600', hex: '#E08411', name: 'amber-600' },
  { token: '--rg-amber-800', hex: '#8F520B', name: 'amber-800' },
  { token: '--rg-amber-900', hex: '#6E3F08', name: 'amber-900' },
];

const neutrals = [
  { token: '--rg-ink-900', hex: '#1C1A17', name: 'ink-900', light: true },
  { token: '--rg-ink-700', hex: '#3D3831', name: 'ink-700', light: true },
  { token: '--rg-stone-600', hex: '#6B6358', name: 'stone-600', light: true },
  { token: '--rg-stone-300', hex: '#DDD4C7', name: 'stone-300' },
  { token: '--rg-stone-100', hex: '#EFE9E0', name: 'stone-100' },
  { token: '--rg-bone', hex: '#FAF7F2', name: 'bone' },
  { token: '--rg-white', hex: '#FFFFFF', name: 'white' },
  { token: '--rg-wordmark', hex: '#231F20', name: 'wordmark', light: true },
];

const system = [
  { token: '--rg-error', hex: '#8C3A2B', name: 'error (brick-700)', light: true },
  { token: '--rg-error-bg', hex: '#F3E4DF', name: 'error-bg (brick-100)' },
  { token: '--rg-success', hex: '#4F6B3A', name: 'success (moss-700)', light: true },
  { token: '--rg-warning', hex: '#8F520B', name: 'warning (amber-800)', light: true },
  { token: '--rg-warning-bg', hex: '#EFE9E0', name: 'warning-bg (stone-100)' },
];

const semantic = [
  { token: '--rg-bg-page', ref: '--rg-bone', name: 'bg-page' },
  { token: '--rg-bg-surface', ref: '--rg-white', name: 'bg-surface' },
  { token: '--rg-bg-subtle', ref: '--rg-stone-100', name: 'bg-subtle' },
  { token: '--rg-bg-inverse', ref: '--rg-ink-900', name: 'bg-inverse', light: true },
  { token: '--rg-text-primary', ref: '--rg-ink-900', name: 'text-primary', light: true },
  { token: '--rg-text-secondary', ref: '--rg-ink-700', name: 'text-secondary', light: true },
  { token: '--rg-text-muted', ref: '--rg-stone-600', name: 'text-muted', light: true },
  { token: '--rg-text-accent', ref: '--rg-amber-800', name: 'text-accent', light: true },
  { token: '--rg-text-on-inverse', ref: '--rg-bone', name: 'text-on-inverse' },
  { token: '--rg-text-accent-on-inverse', ref: '--rg-amber-300', name: 'text-accent-on-inverse' },
  { token: '--rg-border', ref: '--rg-stone-300', name: 'border' },
  { token: '--rg-border-strong', ref: '--rg-stone-600', name: 'border-strong', light: true },
  { token: '--rg-border-inverse', ref: '--rg-ink-700', name: 'border-inverse', light: true },
];

const spacing = [
  { token: '--rg-space-1', px: '4' },
  { token: '--rg-space-2', px: '8' },
  { token: '--rg-space-3', px: '12' },
  { token: '--rg-space-4', px: '16' },
  { token: '--rg-space-5', px: '24' },
  { token: '--rg-space-6', px: '32' },
  { token: '--rg-space-7', px: '48' },
  { token: '--rg-space-8', px: '64' },
  { token: '--rg-space-9', px: '96' },
  { token: '--rg-space-10', px: '128' },
];

const radii = [
  { token: '--rg-radius-xs', px: '2', name: 'xs' },
  { token: '--rg-radius-sm', px: '4', name: 'sm' },
  { token: '--rg-radius-md', px: '6', name: 'md' },
  { token: '--rg-radius-lg', px: '8', name: 'lg' },
];

const shadows = [
  { token: '--rg-shadow-1', name: 'shadow-1', desc: 'Resting cards' },
  { token: '--rg-shadow-2', name: 'shadow-2', desc: 'Hover' },
  { token: '--rg-shadow-3', name: 'shadow-3', desc: 'Dropdowns, sticky headers' },
  { token: '--rg-shadow-4', name: 'shadow-4', desc: 'Modals' },
  { token: '--rg-focus-ring', name: 'focus-ring', desc: 'Focus visible' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Token test — Regenitiva</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <style>
      .tt-wrap { max-width: 1180px; margin: 0 auto; padding: var(--rg-space-7) var(--rg-page-margin); }
      .tt-section { margin-bottom: var(--rg-space-9); }
      .tt-section-title {
        font-family: var(--rg-font-display);
        font-size: var(--rg-size-eyebrow);
        font-weight: var(--rg-weight-semibold);
        letter-spacing: var(--rg-ls-eyebrow);
        text-transform: uppercase;
        color: var(--rg-text-accent);
        margin-bottom: var(--rg-space-5);
      }
      .tt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--rg-space-5); }
      .tt-swatch-card {
        background: var(--rg-bg-surface);
        border: 1px solid var(--rg-border);
        border-radius: var(--rg-radius-lg);
        overflow: hidden;
      }
      .tt-swatch-fill { height: 80px; }
      .tt-swatch-meta { padding: var(--rg-space-3) var(--rg-space-4); }
      .tt-swatch-name {
        font-family: var(--rg-font-display);
        font-size: var(--rg-size-small);
        font-weight: var(--rg-weight-semibold);
      }
      .tt-swatch-token, .tt-swatch-hex {
        font-size: var(--rg-size-caption);
        color: var(--rg-text-muted);
        line-height: var(--rg-lh-caption);
      }
      .tt-heading-sample { margin-bottom: var(--rg-space-5); }
      .tt-heading-meta {
        font-family: var(--rg-font-body);
        font-size: var(--rg-size-caption);
        font-weight: var(--rg-weight-regular);
        color: var(--rg-text-muted);
        letter-spacing: 0;
        text-transform: none;
        margin-top: var(--rg-space-1);
      }
      .tt-space-row { display: flex; align-items: center; gap: var(--rg-space-4); margin-bottom: var(--rg-space-3); }
      .tt-space-bar { height: 20px; background: var(--rg-amber-500); border-radius: var(--rg-radius-xs); }
      .tt-space-label {
        font-size: var(--rg-size-caption);
        color: var(--rg-text-muted);
        white-space: nowrap;
        min-width: 140px;
      }
      .tt-radius-row { display: flex; gap: var(--rg-space-5); flex-wrap: wrap; }
      .tt-radius-box {
        width: 80px; height: 56px;
        background: var(--rg-bg-subtle);
        border: 1px solid var(--rg-border);
        text-align: center;
      }
      .tt-radius-label {
        font-size: var(--rg-size-caption);
        color: var(--rg-text-muted);
        margin-top: var(--rg-space-2);
      }
      .tt-shadow-row { display: flex; gap: var(--rg-space-5); flex-wrap: wrap; }
      .tt-shadow-box {
        width: 100px; height: 72px;
        background: var(--rg-bg-surface);
        border-radius: var(--rg-radius-md);
        display: flex; align-items: center; justify-content: center;
      }
      .tt-shadow-label {
        font-size: var(--rg-size-caption);
        color: var(--rg-text-muted);
        text-align: center;
        margin-top: var(--rg-space-2);
      }
      .tt-body-sample { max-width: var(--rg-measure-body); }
      .tt-gradient-bar { height: 6px; background: var(--rg-gradient-amber); border-radius: var(--rg-radius-xs); margin-bottom: var(--rg-space-7); }
    </style>
  </head>
  <body>
    <div class="tt-wrap">
      <div class="tt-gradient-bar"></div>

      <h1 style="margin-bottom: var(--rg-space-2);">Token test</h1>
      <p style="color: var(--rg-text-muted); margin-bottom: var(--rg-space-9);">Scratch page. Every design token from global.css rendered for visual verification.</p>

      <!-- Amber palette -->
      <section class="tt-section">
        <div class="tt-section-title">Brand amber</div>
        <div class="tt-grid">
          {ambers.map(c => (
            <div class="tt-swatch-card">
              <div class="tt-swatch-fill" style={`background: ${c.hex};`}></div>
              <div class="tt-swatch-meta">
                <div class="tt-swatch-name">{c.name}</div>
                <div class="tt-swatch-token">{c.token}</div>
                <div class="tt-swatch-hex">{c.hex}</div>
              </div>
            </div>
          ))}
          <div class="tt-swatch-card">
            <div class="tt-swatch-fill" style="background: linear-gradient(90deg, #FFCD4D, #F59621);"></div>
            <div class="tt-swatch-meta">
              <div class="tt-swatch-name">gradient-amber</div>
              <div class="tt-swatch-token">--rg-gradient-amber</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Neutrals -->
      <section class="tt-section">
        <div class="tt-section-title">Warm neutrals</div>
        <div class="tt-grid">
          {neutrals.map(c => (
            <div class="tt-swatch-card">
              <div class="tt-swatch-fill" style={`background: ${c.hex};${c.hex === '#FFFFFF' || c.hex === '#FAF7F2' ? ' border-bottom: 1px solid var(--rg-border);' : ''}`}></div>
              <div class="tt-swatch-meta">
                <div class="tt-swatch-name">{c.name}</div>
                <div class="tt-swatch-token">{c.token}</div>
                <div class="tt-swatch-hex">{c.hex}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- System colors -->
      <section class="tt-section">
        <div class="tt-section-title">System colors</div>
        <div class="tt-grid">
          {system.map(c => (
            <div class="tt-swatch-card">
              <div class="tt-swatch-fill" style={`background: ${c.hex};`}></div>
              <div class="tt-swatch-meta">
                <div class="tt-swatch-name">{c.name}</div>
                <div class="tt-swatch-token">{c.token}</div>
                <div class="tt-swatch-hex">{c.hex}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Semantic tokens -->
      <section class="tt-section">
        <div class="tt-section-title">Semantic tokens</div>
        <div class="tt-grid">
          {semantic.map(c => (
            <div class="tt-swatch-card">
              <div class="tt-swatch-fill" style={`background: var(${c.token});${!c.light && c.name.startsWith('bg-') && c.ref !== '--rg-white' ? '' : !c.light ? ' border-bottom: 1px solid var(--rg-border);' : ''}`}>
                {c.name.startsWith('text-') && (
                  <span style={`display: flex; align-items: center; justify-content: center; height: 100%; font-family: var(--rg-font-display); font-size: var(--rg-size-h4); font-weight: var(--rg-weight-semibold); color: var(${c.token}); background: ${c.light ? 'var(--rg-bone)' : 'var(--rg-ink-900)'};`}>Aa</span>
                )}
              </div>
              <div class="tt-swatch-meta">
                <div class="tt-swatch-name">{c.name}</div>
                <div class="tt-swatch-token">{c.token}</div>
                <div class="tt-swatch-hex">→ {c.ref}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Type scale -->
      <section class="tt-section">
        <div class="tt-section-title">Type scale</div>

        <div class="tt-heading-sample">
          <div style="font-family: var(--rg-font-display); font-size: var(--rg-size-display); font-weight: var(--rg-weight-bold); line-height: var(--rg-lh-display); letter-spacing: var(--rg-ls-display);">Practice without hesitation</div>
          <div class="tt-heading-meta">display — Archivo 700 — var(--rg-size-display) — clamp(2.5rem, 1.6rem + 3vw, 4rem)</div>
        </div>

        <div class="tt-heading-sample">
          <h1>Office-based PRP</h1>
          <div class="tt-heading-meta">h1 — Archivo 700 — var(--rg-size-h1) — clamp(2.125rem, 1.6rem + 1.75vw, 3rem)</div>
        </div>

        <div class="tt-heading-sample">
          <h2>Practice Operations and Compliance</h2>
          <div class="tt-heading-meta">h2 — Archivo 600 — var(--rg-size-h2) — clamp(1.6875rem, 1.35rem + 1.125vw, 2.25rem)</div>
        </div>

        <div class="tt-heading-sample">
          <h3>Credentialing and provider support</h3>
          <div class="tt-heading-meta">h3 — Archivo 600 — var(--rg-size-h3) — clamp(1.4375rem, 1.25rem + 0.625vw, 1.75rem)</div>
        </div>

        <div class="tt-heading-sample">
          <h4>Competency training for your staff</h4>
          <div class="tt-heading-meta">h4 — Archivo 600 — var(--rg-size-h4) — 1.375rem (22px)</div>
        </div>

        <div class="tt-heading-sample">
          <h5>Protocol documentation schedule</h5>
          <div class="tt-heading-meta">h5 — Archivo 600 — var(--rg-size-h5) — 1.125rem (18px) — derived</div>
        </div>

        <div class="tt-heading-sample">
          <h6>Audit readiness checklist</h6>
          <div class="tt-heading-meta">h6 — Archivo 600 — var(--rg-size-h6) — 1rem (16px) — derived</div>
        </div>

        <div class="tt-heading-sample">
          <p style="font-size: var(--rg-size-lead); line-height: var(--rg-lh-lead); color: var(--rg-text-secondary); max-width: var(--rg-measure-lead);">You add a modality your practice does not have today. We add the compliance program that stands behind it.</p>
          <div class="tt-heading-meta">lead — Roboto 400 — var(--rg-size-lead) — 1.25rem (20px) — max 62ch</div>
        </div>

        <div class="tt-heading-sample tt-body-sample">
          <p>Regenitiva builds the operational layer around an office-based PRP service line: AAAHC-aligned policies, written clinical protocols, staff competency checks, credentialing support, and outcome tracking that feeds back into the protocol.</p>
          <div class="tt-heading-meta">body — Roboto 400 — var(--rg-size-body) — 1.0625rem (17px) — max 72ch</div>
        </div>

        <div class="tt-heading-sample">
          <p style="font-size: var(--rg-size-small); line-height: var(--rg-lh-small); color: var(--rg-text-secondary);">Supporting detail, table cells, card descriptions, and form help text.</p>
          <div class="tt-heading-meta">small — Roboto 400 — var(--rg-size-small) — 0.9375rem (15px)</div>
        </div>

        <div class="tt-heading-sample">
          <p style="font-size: var(--rg-size-caption); line-height: var(--rg-lh-caption); letter-spacing: 0.01em; color: var(--rg-text-muted);">Outcome data reflects a single practice cohort and is not a projection.</p>
          <div class="tt-heading-meta">caption — Roboto 400 — var(--rg-size-caption) — 0.8125rem (13px) — stone-600</div>
        </div>

        <div class="tt-heading-sample">
          <span style="display: inline-flex; font-family: var(--rg-font-body); font-size: var(--rg-size-button); font-weight: var(--rg-weight-medium); line-height: 1; letter-spacing: var(--rg-ls-button); background: var(--rg-amber-500); color: var(--rg-ink-900); padding: 14px 24px; border-radius: var(--rg-radius-md);">Request a practice review</span>
          <div class="tt-heading-meta">button label — Roboto 500 — var(--rg-size-button) — 1rem (16px)</div>
        </div>

        <div class="tt-heading-sample">
          <div style="font-family: var(--rg-font-display); font-size: var(--rg-size-eyebrow); font-weight: var(--rg-weight-semibold); line-height: 1.2; letter-spacing: var(--rg-ls-eyebrow); text-transform: uppercase; color: var(--rg-text-accent);">Compliance &amp; accreditation</div>
          <div class="tt-heading-meta">eyebrow — Archivo 600 — var(--rg-size-eyebrow) — 0.75rem (12px) — uppercase, amber-800</div>
        </div>
      </section>

      <!-- Links -->
      <section class="tt-section">
        <div class="tt-section-title">Links</div>
        <p style="margin-bottom: var(--rg-space-4);">
          <a href="#!">Default link (amber-800)</a> — hover to see amber-900 + underline.
        </p>
        <div style="background: var(--rg-bg-inverse); padding: var(--rg-space-5); border-radius: var(--rg-radius-lg);">
          <a href="#!" style="color: var(--rg-text-accent-on-inverse);">Link on dark surface (amber-300)</a>
        </div>
      </section>

      <!-- Spacing scale -->
      <section class="tt-section">
        <div class="tt-section-title">Spacing scale — 4px base</div>
        {spacing.map(s => (
          <div class="tt-space-row">
            <div class="tt-space-label">{s.token} — {s.px}px</div>
            <div class="tt-space-bar" style={`width: ${s.px}px;`}></div>
          </div>
        ))}
      </section>

      <!-- Radii -->
      <section class="tt-section">
        <div class="tt-section-title">Border radii</div>
        <div class="tt-radius-row">
          {radii.map(r => (
            <div>
              <div class="tt-radius-box" style={`border-radius: ${r.px}px;`}></div>
              <div class="tt-radius-label">{r.name} — {r.px}px</div>
            </div>
          ))}
        </div>
      </section>

      <!-- Shadows -->
      <section class="tt-section">
        <div class="tt-section-title">Elevation</div>
        <div class="tt-shadow-row">
          {shadows.map(s => (
            <div>
              <div class="tt-shadow-box" style={`box-shadow: var(${s.token});`}></div>
              <div class="tt-shadow-label">{s.name}<br />{s.desc}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- Selection -->
      <section class="tt-section">
        <div class="tt-section-title">::selection</div>
        <p>Select this text to verify the amber-300 background with ink-900 text.</p>
      </section>

    </div>
  </body>
</html>
