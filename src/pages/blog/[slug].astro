---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getReadTime, formatDate, validateCategory } from '../../lib/blog';
import { getTeamMemberByName } from '../../data/team';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

validateCategory(post.data.category, post.id);

const readTime = post.body ? getReadTime(post.body) : 3;
const authorMember = getTeamMemberByName(post.data.author);
const formattedDate = formatDate(post.data.date);

// Get related posts (same category, exclude current, max 3)
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const relatedPosts = allPosts
  .filter(p => p.data.category === post.data.category && p.id !== post.id)
  .slice(0, 3)
  .map(p => ({
    slug: p.id,
    title: p.data.title,
    category: p.data.category,
    date: formatDate(p.data.date),
  }));
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.excerpt}
  category={post.data.category}
  date={formattedDate}
  author={post.data.author}
  authorSlug={authorMember?.id}
  authorTitle={post.data.authorTitle}
  authorBio={post.data.authorBio}
  readTime={readTime}
  relatedPosts={relatedPosts}
>
  <Content />
</BlogPostLayout>
