---
interface Props {
  title: string;
  href: string;
  category: string;
  date: string;
  excerpt?: string;
  variant?: 'grid' | 'featured';
}

const {
  title,
  href,
  category,
  date,
  excerpt,
  variant = 'grid',
} = Astro.props;
---

{variant === 'featured' ? (
  <a href={href} class="bc-featured">
    <div class="bc-featured-thumb"></div>
    <div class="bc-featured-content">
      <div class="bc-meta">
        <span class="bc-category">{category}</span>
        <span class="bc-meta-sep">&middot;</span>
        <span class="bc-date">{date}</span>
      </div>
      <h2 class="bc-featured-title">{title}</h2>
      {excerpt && <p class="bc-excerpt">{excerpt}</p>}
      <span class="bc-read-more">Read the full post &rarr;</span>
    </div>
  </a>
) : (
  <a href={href} class="bc-card">
    <div class="bc-thumb"></div>
    <div class="bc-card-body">
      <div class="bc-meta">
        <span class="bc-category">{category}</span>
        <span class="bc-meta-sep">&middot;</span>
        <span class="bc-date">{date}</span>
      </div>
      <h3 class="bc-card-title">{title}</h3>
      {excerpt && <p class="bc-excerpt">{excerpt}</p>}
    </div>
  </a>
)}

<style>
  /* ----------------------------------------------------------------
     Grid variant
     ---------------------------------------------------------------- */
  .bc-card {
    display: block;
    text-decoration: none;
    border: 1px solid var(--rg-border);
    border-radius: var(--rg-radius-lg);
    background: var(--rg-bg-surface);
    overflow: hidden;
    transition: box-shadow var(--rg-duration-slow) var(--rg-ease);
  }

  .bc-card:hover {
    text-decoration: none;
    box-shadow: var(--rg-shadow-2);
  }

  .bc-thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--rg-stone-300);
  }

  .bc-card-body {
    padding: var(--rg-space-4) var(--rg-space-5) var(--rg-space-5);
  }

  .bc-card-title {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-h5);
    font-weight: var(--rg-weight-semibold);
    line-height: var(--rg-lh-h5);
    letter-spacing: var(--rg-ls-h5);
    color: var(--rg-text-primary);
    margin-bottom: var(--rg-space-2);
  }

  /* ----------------------------------------------------------------
     Featured variant
     ---------------------------------------------------------------- */
  .bc-featured {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border: 1px solid var(--rg-border);
    border-radius: var(--rg-radius-lg);
    background: var(--rg-bg-surface);
    overflow: hidden;
    transition: box-shadow var(--rg-duration-slow) var(--rg-ease);
  }

  .bc-featured:hover {
    text-decoration: none;
    box-shadow: var(--rg-shadow-2);
  }

  .bc-featured-thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--rg-stone-300);
  }

  .bc-featured-content {
    padding: var(--rg-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--rg-space-3);
  }

  .bc-featured-title {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-h3);
    font-weight: var(--rg-weight-regular);
    line-height: var(--rg-lh-h3);
    letter-spacing: var(--rg-ls-h3);
    color: var(--rg-text-primary);
  }

  @media (min-width: 768px) {
    .bc-featured {
      flex-direction: row;
    }

    .bc-featured-thumb {
      flex: 1.1;
      aspect-ratio: auto;
      min-height: 280px;
    }

    .bc-featured-content {
      flex: 0.9;
      padding: var(--rg-space-6);
      justify-content: center;
    }
  }

  /* ----------------------------------------------------------------
     Shared
     ---------------------------------------------------------------- */
  .bc-meta {
    font-size: var(--rg-size-caption);
    color: var(--rg-text-muted);
  }

  .bc-category {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-eyebrow);
    font-weight: var(--rg-weight-bold);
    letter-spacing: var(--rg-ls-eyebrow);
    text-transform: uppercase;
    color: var(--rg-text-accent);
  }

  .bc-meta-sep {
    margin: 0 var(--rg-space-2);
    color: var(--rg-text-muted);
  }

  .bc-date {
    font-size: var(--rg-size-caption);
    color: var(--rg-text-muted);
  }

  .bc-excerpt {
    font-size: var(--rg-size-small);
    line-height: var(--rg-lh-body);
    color: var(--rg-text-secondary);
    margin: 0;
  }

  .bc-read-more {
    font-family: var(--rg-font-display);
    font-size: var(--rg-size-small);
    font-weight: var(--rg-weight-semibold);
    color: var(--rg-text-accent);
  }
</style>
